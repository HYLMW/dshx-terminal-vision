{
  "name": "dshx-terminal",
  "version": "0.4.2",
  "description": "A native interactive terminal frontend for DeepSeek Harness",
  "author": "Yuhang Tian",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "coding-agent",
    "terminal",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maydaytyh/dshx-terminal.git"
  },
  "homepage": "https://github.com/Maydaytyh/dshx-terminal#readme",
  "bugs": {
    "url": "https://github.com/Maydaytyh/dshx-terminal/issues"
  },
  "bin": {
    "dshx": "bin/dshx.js"
  },
  "exports": {
    ".": "./lib/runner.js",
    "./runner": "./lib/runner.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test",
    "pack:local": "npm pack --pack-destination dist"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-stats": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-ask-user": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
